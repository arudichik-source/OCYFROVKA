<Window x:Class="Ocyfrovka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ОЦИФРОВКА" Height="840" Width="1320" MinHeight="700" MinWidth="1080"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="Window_Drop" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#2A2F3A" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ОЦИФРОВКА" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Локальне оцифрування документів" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Додати файли" Click="AddFiles_Click" Padding="18,9" Margin="8"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="470"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#2A2F3A" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,18">
                    <TextBlock Text="РОЗДІЛИ" Margin="8,0,8,10" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <Button Content="Нове оцифрування" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    <Button Content="Черга" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    <Button Content="Перевірка" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    <Button Content="Готові" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    <Button Content="Історія" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    <Button Content="Довідники" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    <Button Content="Шаблони" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    <Button Content="Налаштування" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Сторінки документа" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageCountText" Grid.Column="1" Text="Сторінок: 0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="#343A46" BorderThickness="1" CornerRadius="8">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Перетягніть сюди JPG, PNG, BMP, TIFF або PDF"
                                   HorizontalAlignment="Center" Margin="0,4,0,12"
                                   FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>

                        <ListBox x:Name="InputFilesList" Grid.Row="1"
                                 SelectionChanged="InputFilesList_SelectionChanged"
                                 Background="#151820" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="#343A46" BorderThickness="1" Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SourcePath}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center"
                                                   Text="{Binding RotationDegrees, StringFormat='Поворот: {0}°'}"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Content="↑ Вище" Click="MoveUp_Click" Padding="11,7" Margin="3"/>
                            <Button Content="↓ Нижче" Click="MoveDown_Click" Padding="11,7" Margin="3"/>
                            <Button Content="↶ 90°" Click="RotateLeft_Click" Padding="11,7" Margin="3"/>
                            <Button Content="↷ 90°" Click="RotateRight_Click" Padding="11,7" Margin="3"/>
                            <Button Content="Видалити" Click="RemovePage_Click" Padding="11,7" Margin="3"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2" Margin="0,18,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="230"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Попередній перегляд" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PreviewModeText" Grid.Column="1" Text="Оригінал"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="#343A46" BorderThickness="1" CornerRadius="8">
                    <Grid Margin="10">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <TextBlock x:Name="PreviewHintText" Text="Оберіть сторінку для перегляду"
                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                   Margin="36" Foreground="{StaticResource MutedTextBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Оригінал" Click="ShowOriginal_Click" Padding="11,7" Margin="3"/>
                        <Button Content="Оброблено" Click="ShowProcessed_Click" Padding="11,7" Margin="3"/>
                        <ComboBox x:Name="ProfileComboBox" SelectedIndex="0" Width="145" Margin="8,3,3,3">
                            <ComboBoxItem Content="Авто"/>
                            <ComboBoxItem Content="Відтінки сірого"/>
                            <ComboBoxItem Content="Високий контраст"/>
                            <ComboBoxItem Content="Ч/Б (Otsu)"/>
                            <ComboBoxItem Content="Адаптивний Ч/Б"/>
                            <ComboBoxItem Content="Корекція освітлення"/>
                            <ComboBoxItem Content="Різкість"/>
                        </ComboBox>
                        <Button Content="Обробити" Click="ProcessSelected_Click" Padding="13,7" Margin="3"/>
                        <Button Content="Обрізати межі" Click="ApplyCrop_Click" Padding="11,7" Margin="3"/>
                        <Button Content="Повний кадр" Click="ResetCrop_Click" Padding="11,7" Margin="3"/>
                    </WrapPanel>
                </StackPanel>

                <TextBlock x:Name="PreviewInfoText" Grid.Row="3" Margin="2,8,2,8"
                           Text="Оригінал не змінюється."
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

                <Border Grid.Row="4" Background="{StaticResource CardBrush}" BorderBrush="#343A46" BorderThickness="1" CornerRadius="8">
                    <TabControl Background="#151820" Foreground="{StaticResource TextBrush}" BorderThickness="0">
                        <TabItem Header="Текст">
                            <TextBox x:Name="OcrTextBox"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="#151820"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     Padding="8"/>
                        </TabItem>
                        <TabItem Header="Таблиця">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LayoutStatusText"
                                               Text="Структура ще не аналізувалась."
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                                        <Button Content="Підтвердити" Click="ConfirmReviewCell_Click" Padding="9,5" Margin="2"/>
                                        <Button Content="Підтвердити все" Click="ConfirmAllReviewCells_Click" Padding="9,5" Margin="2"/>
                                        <Button Content="Довідник" Click="ApplyDictionary_Click" Padding="9,5" Margin="2"/>
                                        <Button Content="Прийняти пропозицію" Click="AcceptReviewSuggestion_Click" Padding="9,5" Margin="2"/>
                                        <Button Content="Помилка" Click="MarkReviewCellError_Click" Padding="9,5" Margin="2"/>
                                        <Button Content="До OCR" Click="ResetReviewCell_Click" Padding="9,5" Margin="2"/>
                                    </WrapPanel>
                                </Grid>
                                <DataGrid x:Name="StructuredTableGrid"
                                          Grid.Row="1"
                                          IsReadOnly="False"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionUnit="Cell"
                                          SelectionMode="Single"
                                          SelectedCellsChanged="StructuredTableGrid_SelectedCellsChanged"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          Background="#151820"
                                          Foreground="{StaticResource TextBrush}"
                                          BorderBrush="#343A46"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="#2A2F3A" BorderThickness="0,1,0,0">
            <Grid Margin="18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Stage 6: перевірка OCR" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="Мова OCR:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="OcrLanguageComboBox"
                              IsEditable="True"
                              Width="135"
                              MinHeight="30"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Очистити" Click="Clear_Click" Padding="16,8" Margin="4,0"/>
                    <Button x:Name="DigitizeButton" Content="Оцифрувати" Click="Digitize_Click" Padding="18,8" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
