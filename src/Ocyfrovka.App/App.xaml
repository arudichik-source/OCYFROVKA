<Application x:Class="Ocyfrovka.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#111318"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#191C23"/>
        <SolidColorBrush x:Key="CardBrush" Color="#20242D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A8B0BF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6EA8FE"/>
    </Application.Resources>
</Application>